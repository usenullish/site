---
import Default from "@astrojs/starlight/components/SocialIcons.astro";
import { i18n } from "./i18n/i18n.ts";

const isLanding = Astro.locals.starlightRoute.entry.data.hero !== undefined;

const { lang, nav } = i18n(Astro.locals.starlightRoute.locale);
---

{isLanding && (
  <Fragment>
    <a class="nav optional" href={`/${lang}/features/`}>
      {nav.features}
    </a>
    <a class="nav" href={`/${lang}/pricing/`}>
      {nav.pricing}
    </a>
    <a class="nav" href={`/${lang}/getting-started/`}>
      {nav.docs}
    </a>
  </Fragment>
)}
<Default />

<style>
  .nav {
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }

  .nav:hover {
    color: var(--sl-color-text-accent);
  }

  @media (max-width: 49.99rem) {
    .optional {
      display: none;
    }
  }
</style>
