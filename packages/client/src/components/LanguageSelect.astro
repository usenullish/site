---
import Default from "@astrojs/starlight/components/LanguageSelect.astro";

interface Props {
  footer?: boolean;
}

const { footer = false } = Astro.props;

const isLanding = Astro.locals.starlightRoute.entry.data.hero !== undefined;
---

{footer ? (
  <Default />
) : (
  !isLanding && (
    <div class="lang">
      <Default />
    </div>
  )
)}

<style>
  .lang {
    display: flex;
    align-items: center;
    color: var(--sl-color-white);
  }

  .lang:hover {
    color: var(--sl-color-text-accent);
  }

  .lang :global(label) {
    color: inherit;
  }

  .lang :global(option) {
    color: var(--sl-color-white);
    background-color: var(--sl-color-bg-nav);
  }
</style>
