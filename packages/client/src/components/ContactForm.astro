---
import { i18n } from "./i18n/i18n.ts";

interface Props {
  plan: "tester" | "instance" | "on-prem";
}

const { plan } = Astro.props;

const { lang, contact } = i18n(Astro.currentLocale);
---

<form id="contact-form" class="contact not-content" method="post" action="/api/contact">
  <input type="hidden" name="lang" value={lang} />
  <input type="hidden" name="plan" value={plan} />

  <div class="honeypot" aria-hidden="true">
    <label>
      Website
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <div class="row">
    <label>
      <span>{contact.label.name}</span>
      <input type="text" name="name" required maxlength="200" autocomplete="name" />
    </label>

    <label>
      <span>{contact.label.email}</span>
      <input type="email" name="email" required maxlength="320" autocomplete="email" />
    </label>
  </div>

  <label>
    <span>{contact.label.company}</span>
    <input type="text" name="company" maxlength="200" autocomplete="organization" />
  </label>

  <label>
    <span>{contact.label.message}</span>
    <textarea name="message" rows="5" maxlength="5000"></textarea>
  </label>

  <div class="status" aria-live="polite">
    <p data-status="sent" hidden>
      {contact.status.sent}
    </p>
    <p class="error" data-status="error" hidden>
      {contact.status.error}
    </p>
    <p class="error" data-status="limit" hidden>
      {contact.status.limit}
    </p>
  </div>

  <button type="submit" class="submit">
    {contact.action.send}
  </button>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");

  const show = (status: string | null) => {
    let shown: HTMLElement | undefined;

    form?.querySelectorAll<HTMLElement>("[data-status]").forEach((element) => {
      element.hidden = element.dataset.status !== status;

      if (!element.hidden) {
        shown = element;
      }
    });

    shown?.scrollIntoView({ block: "nearest" });
  };

  show(new URLSearchParams(window.location.search).get("status"));

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");

    if (button) {
      button.disabled = true;
    }

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });

      const { status } = (await response.json()) as { status: string };

      show(status);

      if (status === "sent") {
        form.reset();
      }
    } catch {
      show("error");
    } finally {
      if (button) {
        button.disabled = false;
      }
    }
  });
</script>

<style>
  .contact {
    display: grid;
    gap: 1rem;
    max-width: 40rem;
    margin-block: 1.5rem 6rem;
  }

  .row {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 50rem) {
    .row {
      grid-template-columns: 1fr 1fr;
    }
  }

  label {
    display: grid;
    gap: 0.375rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  input,
  textarea {
    width: 100%;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    font: inherit;
    font-size: var(--sl-text-base);
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: -1px;
  }

  textarea {
    resize: vertical;
  }

  .submit {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    padding: 0.4375rem 1.125rem;
    border: 1px solid var(--sl-color-text-accent);
    border-radius: 0;
    background: var(--sl-color-text-accent);
    color: var(--sl-color-black);
    font: inherit;
    font-size: var(--sl-text-sm);
    line-height: 1.1875;
    cursor: pointer;
    transition:
      background-color 150ms,
      border-color 150ms;
  }

  :global(:root[data-theme="dark"]) .submit {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }

  .submit:hover {
    background: color-mix(in oklch, var(--sl-color-text-accent) 80%, transparent);
    border-color: transparent;
  }

  .submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .submit:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 0.25rem;
  }

  @media (min-width: 50rem) {
    .submit {
      padding: 0.9375rem 1.25rem;
      font-size: var(--sl-text-base);
    }
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .status:empty {
    display: none;
  }

  .status p {
    margin: 0;
    padding: 0.75rem 1rem;
    border-inline-start: 3px solid var(--sl-color-text-accent);
    background: color-mix(in oklch, var(--sl-color-text-accent) 12%, transparent);
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
  }

  .status p.error {
    border-inline-start-color: var(--sl-color-red);
    background: color-mix(in oklch, var(--sl-color-red) 12%, transparent);
  }

  .status p[hidden] {
    display: none;
  }
</style>
