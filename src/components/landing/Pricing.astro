---
import { LinkButton } from "@astrojs/starlight/components";
import { i18n } from "../i18n/i18n.ts";
import plans from "../../assets/plans.json";

const { lang, pricing } = i18n(Astro.currentLocale);

const periods = ["month", "year"] as const;

type Period = (typeof periods)[number];

const format = (amount: number): string =>
  new Intl.NumberFormat(`${lang}-CH`, {
    style: "currency",
    currency: plans.currency,
    maximumFractionDigits: 0,
  }).format(amount);

const monthly = ({ prices, period }: { prices: Record<Period, number>; period: Period }) =>
  period === "year" ? Math.round(prices.year / 12) : prices.month;

const contactUrl = `/${lang}/contact/`;

const priced = [
  {
    ...plans.cloud,
    ...pricing.cloud,
    href: `/${lang}/getting-started/`,
  },
  {
    ...plans.instance,
    ...pricing.instance,
    href: contactUrl,
  },
];

const onPrem = { ...plans.onPrem, ...pricing.onPrem };
---

<div class="pricing not-content">
  <fieldset class="billing">
    <legend class="sr-only">{pricing.billing.label}</legend>
    {periods.map((period) => (
      <label>
        <input type="radio" name="billing" value={period} checked={period === "year"} />
        <span>{pricing.billing[period]}</span>
      </label>
    ))}
  </fieldset>

  <div class="plans">
    {priced.map(({ name, description, features, action, prices, href }) => (
      <article class="plan">
        <h2>{name}</h2>
        <p class="description">{description}</p>

        {periods.map((period) => (
          <p class="price" data-period={period}>
            <span class="amount">{format(monthly({ prices, period }))}</span>{" "}
            <span class="period">
              {period === "year" ? pricing.perMonthBilledYearly : pricing.perMonth}
            </span>
          </p>
        ))}

        <ul class="features">
          {features.map((feature) => (
            <li>{feature}</li>
          ))}
        </ul>

        <LinkButton {href} variant="primary" class="action">
          {action}
        </LinkButton>
      </article>
    ))}

    <article class="plan wide">
      <h2>{onPrem.name}</h2>
      <p class="description">{onPrem.description}</p>

      <p class="price">
        <span class="amount">{pricing.customPricing}</span>
      </p>

      <ul class="features">
        {onPrem.features.map((feature) => (
          <li>{feature}</li>
        ))}
      </ul>

      <LinkButton href={contactUrl} variant="secondary" class="action">
        {onPrem.action}
      </LinkButton>
    </article>
  </div>

  <p class="vat">{pricing.vatExcluded}</p>
</div>

<style>
  .pricing {
    padding-block: 2rem 6rem;
    line-height: 1.5;
  }

  .billing {
    display: flex;
    width: fit-content;
    margin: 0 0 1.5rem auto;
    padding: 0;
    border: var(--layout-section-border);
  }

  .billing label {
    cursor: pointer;
  }

  .billing input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .billing span {
    display: block;
    padding: 0.375rem 1rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .billing input:checked + span {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  .billing input:focus-visible + span {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: -2px;
  }

  .pricing:has(input[value="year"]:checked) .price[data-period="month"],
  .pricing:has(input[value="month"]:checked) .price[data-period="year"] {
    display: none;
  }

  .plans {
    display: grid;
    gap: 1rem;
  }

  .plan {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border: var(--layout-section-border);
    background: var(--sl-color-bg);
  }

  h2 {
    margin: 0;
    color: var(--sl-color-white);
    font-size: var(--sl-text-2xl);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .description {
    margin: 0.25rem 0 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .price {
    margin: 1.5rem 0 0;
  }

  .amount {
    color: var(--sl-color-white);
    font-size: var(--sl-text-xl);
    font-weight: 600;
  }

  .period {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }

  .features {
    flex: 1;
    display: grid;
    align-content: start;
    gap: 0.5rem;
    margin: 1.5rem 0;
    padding: 0;
    list-style: none;
    color: var(--sl-color-gray-2);
  }

  .features li::before {
    content: "/ ";
    color: var(--sl-color-text-accent);
    font-weight: 700;
  }

  .plan :global(.action) {
    justify-content: center;
  }

  .vat {
    margin: 1.5rem 0 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }

  @media (min-width: 50rem) {
    .plans {
      grid-template-columns: repeat(2, 1fr);
    }

    .wide {
      grid-column: 1 / -1;
      margin-block-start: 1rem;
    }
  }
</style>
