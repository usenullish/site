---
import Section from "./Section.astro";
import { i18n } from "../i18n/i18n.ts";

const { lessBoring } = i18n(Astro.locals.starlightRoute.locale);
const { cards } = lessBoring;
---

<Section label={lessBoring.label} title={lessBoring.title}>
  <ul class="cards">
    {cards.map(({ title, text }) => (
      <li class="card">
        <h3>{title}</h3>
        <p>{text}</p>
      </li>
    ))}
  </ul>
</Section>

<style>
  .cards {
    display: grid;
    grid-template-columns: 1fr;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    border-block-start: var(--layout-section-border);
    border-inline-start: var(--layout-section-border);
  }

  .card {
    position: relative;
    padding: 1.5rem;
    border-block-end: var(--layout-section-border);
    border-inline-end: var(--layout-section-border);
  }

  .card::after {
    content: "/";
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    translate: 50% -50%;
    padding-inline: 0.25rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-sm);
    font-weight: 700;
    line-height: 1;
    z-index: 1;
  }

  h3 {
    margin: 0;
    color: var(--sl-color-white);
    font-size: var(--sl-text-lg);
    font-weight: 600;
  }

  p {
    margin: 0.5rem 0 0;
    color: var(--sl-color-gray-2);
  }

  @media (min-width: 50rem) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 72rem) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
