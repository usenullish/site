---
import Default from "@astrojs/starlight/components/Footer.astro";
import { Icon } from "@astrojs/starlight/components";
import { i18n } from "../i18n/i18n.ts";

const isLanding = Astro.locals.starlightRoute.entry.data.hero !== undefined;

const { lang, footer } = i18n(Astro.locals.starlightRoute.locale);

const columns = [
  {
    title: footer.product,
    links: [
      { label: footer.getStarted, href: `/${lang}/getting-started/` },
      { label: footer.becomeTester, href: "https://tally.so/r/BEKO81", external: true },
      { label: footer.status, href: "https://nullishstatus.com/", external: true },
    ],
  },
  {
    title: footer.docs,
    links: [
      { label: footer.assistant, href: `/${lang}/assistant/` },
      { label: footer.billing, href: `/${lang}/billing/` },
      { label: footer.banking, href: `/${lang}/banking/` },
      { label: footer.accounting, href: `/${lang}/accounting/` },
      { label: footer.migrate, href: `/${lang}/migration/` },
    ],
  },
  {
    title: footer.developers,
    links: [
      { label: "REST API", href: `/${lang}/developers/api/` },
      { label: "MCP", href: `/${lang}/developers/mcp/` },
      { label: footer.selfHosting, href: `/${lang}/developers/self-hosting/` },
    ],
  },
  {
    title: footer.community,
    links: [
      { label: "GitHub", href: "https://github.com/usenullish/nullish", external: true },
      { label: "Templates", href: "https://github.com/usenullish/templates", external: true },
    ],
  },
];
---

{isLanding ? (
  <footer class="not-content">
    <nav class="columns" aria-label="Footer">
      {columns.map(({ title, links }) => (
        <div>
          <p class="title">
            <span class="slashes" aria-hidden="true">
              {"//"}
            </span>{" "}
            {title}
          </p>
          <ul>
            {links.map(({ label, href, external }) => (
              <li>
                <a {href} {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
                  {label}
                  {external && <Icon name="external" size="0.875em" />}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    <svg class="wordmark" viewBox="0 0 280.81 79.58" role="img" aria-label="nullish">
      <path d="M33.08 27.27c-2.75-2.97-6.43-4.46-11.03-4.46-3.82 0-6.83 1.05-9.05 3.16-1.75 1.66-2.79 3.84-3.16 6.52h-.16v-8.84H0v46.29h9.85V40.82c0-3.03.79-5.37 2.36-7.03s3.73-2.48 6.48-2.48 4.81.79 6.35 2.36 2.31 3.82 2.31 6.73v29.54h9.85V39.39c0-5.11-1.38-9.15-4.12-12.12M65.37 70.79c-5.72 0-10.25-1.63-13.59-4.88s-5.01-7.69-5.01-13.3V23.66h9.85v28.87c0 3.09.77 5.47 2.31 7.15s3.69 2.53 6.44 2.53 4.99-.84 6.57-2.53c1.57-1.68 2.36-4.07 2.36-7.15V23.66h9.85v28.95c0 5.61-1.7 10.04-5.09 13.3-3.4 3.25-7.95 4.88-13.68 4.88ZM147.83 69.95v-8.92h16.24V32.5h-14.14v-8.84h23.57v37.37h14.64v8.92h-40.32Zm20.12-54.21c-2.08 0-3.7-.52-4.88-1.56s-1.77-2.45-1.77-4.25.59-3.31 1.77-4.38c1.18-1.06 2.8-1.6 4.88-1.6s3.7.53 4.88 1.6q1.77 1.605 1.77 4.38c0 2.775-.59 3.21-1.77 4.25s-2.81 1.56-4.88 1.56M209.94 70.7c-3.42 0-6.41-.55-8.96-1.64s-4.57-2.61-6.06-4.54c-1.49-1.94-2.31-4.22-2.48-6.86h9.85c.17 1.51.94 2.72 2.31 3.62s3.16 1.35 5.34 1.35h3.62c2.69 0 4.71-.53 6.06-1.6 1.35-1.06 2.02-2.5 2.02-4.29 0-1.68-.6-3.02-1.81-4q-1.815-1.47-5.43-1.98l-5.89-.84c-5.11-.79-8.85-2.2-11.24-4.25s-3.58-5.12-3.58-9.22c0-4.32 1.42-7.66 4.25-10.02s7.03-3.53 12.58-3.53h3.2c4.99 0 8.98 1.12 11.95 3.37s4.63 5.27 4.97 9.09h-9.85c-.17-1.29-.87-2.34-2.1-3.16-1.23-.81-2.89-1.22-4.97-1.22h-3.2c-2.52 0-4.36.46-5.51 1.39s-1.73 2.29-1.73 4.08c0 1.63.5 2.85 1.52 3.66 1.01.81 2.61 1.39 4.8 1.73l6.06.84c5.33.79 9.26 2.26 11.78 4.42 2.53 2.16 3.79 5.32 3.79 9.47 0 4.49-1.47 7.97-4.42 10.44s-7.36 3.7-13.26 3.7h-3.62ZM276.69 27.27c-2.75-2.97-6.43-4.46-11.03-4.46-3.82 0-6.83 1.05-9.05 3.16-1.75 1.66-2.79 3.84-3.16 6.52h-.16l.17-8.84V8.5h-9.85v61.44h9.85V40.82c0-3.03.79-5.39 2.36-7.07q2.355-2.52 6.48-2.52c4.125 0 4.81.8 6.35 2.4q2.31 2.4 2.31 6.78v29.54h9.85V39.4c0-5.11-1.38-9.15-4.12-12.12Z" />
      <path
        class="slashes"
        d="M100.33 79.58H88.14L111.62 0h12.18zM124.36 79.58h-12.19L135.64 0h12.19z"
      />
    </svg>
  </footer>
) : (
  <Default />
)}

<style>
  footer {
    background: var(--sl-color-text-accent);
    color: var(--sl-color-black);
  }

  @media (max-width: 1139.98px) {
    footer {
      margin: 1.5rem calc(-1 * var(--sl-content-pad-x)) -1.5rem;
      padding: 3rem var(--sl-content-pad-x);
    }
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    line-height: 1.5;
  }

  .title {
    margin: 0;
    font-size: var(--sl-text-sm);
    opacity: 0.7;
  }

  .columns .slashes {
    font-weight: 700;
  }

  .slashes {
    color: #8554fd;
    fill: #8554fd;
  }

  :global(:root[data-theme="light"]) .slashes {
    color: #fff;
    fill: #fff;
  }

  ul {
    display: grid;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 50rem) {
    .columns {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .wordmark {
    display: block;
    width: 70%;
    height: auto;
    margin-block-start: 6rem;
    fill: currentColor;
  }
</style>
