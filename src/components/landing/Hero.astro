---
import { LinkButton } from "@astrojs/starlight/components";
import { i18n } from "../i18n/i18n.ts";
import Header from "./Header.astro";
import HeroAssistant from "./HeroAssistant.astro";

const { id, data } = Astro.locals.starlightRoute.entry;
const { locale } = Astro.locals.starlightRoute;
const { title, tagline, actions = [] } = data.hero ?? {};
const { lang, hero } = i18n(locale);

const isHome = id === locale;

const formatAmount = (value: number): string =>
  new Intl.NumberFormat(`${lang}-CH`, { minimumFractionDigits: 2 }).format(value);
---

<Header
  label={data.label ?? hero.label}
  title={title === undefined ? hero.title : [title]}
  {tagline}
>
  {isHome && (
    <div slot="badge" class="banner">
      <span class="banner-dot"></span>
      <span>{hero.badge}</span>
    </div>
  )}

  {actions.length > 0 && (
    <div class="sl-flex actions">
      {actions.map(
        ({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
          <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
            {text}
            {icon?.html && <Fragment set:html={icon.html} />}
          </LinkButton>
        ),
      )}
    </div>
  )}

  {isHome && <HeroAssistant slot="aside" />}

  {isHome && (
    <div slot="footer" class="ledger" aria-hidden="true">
      <p>
        {hero.ledger.debit} <span class="amount">{formatAmount(48210.35)}</span>
      </p>
      <p>
        {hero.ledger.credit} <span class="amount">{formatAmount(48210.35)}</span>
      </p>
      <p class="balance">
        {hero.ledger.balance} <span class="amount">{formatAmount(0)}</span>
      </p>
    </div>
  )}
</Header>

<style>
  @layer starlight.core {
    .ledger {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      margin-block-start: 2rem;
      padding-block-start: 1rem;
      border-block-start: var(--layout-section-border);
      color: var(--sl-color-gray-3);
      font-size: var(--sl-text-sm);
    }

    .ledger p {
      margin: 0;
    }

    @media (max-width: 49.99rem) {
      .ledger {
        display: none;
      }
    }

    .ledger p:nth-child(2) {
      justify-self: center;
    }

    .ledger .balance {
      justify-self: end;
    }

    .ledger .balance .amount {
      display: inline-block;
      padding-block-end: 0.15rem;
      border-block-end: 3px double var(--sl-color-accent);
    }

    .banner {
      display: flex;
      align-items: center;
      gap: 8px;
      box-sizing: border-box;
      height: var(--header-badge-height);
      padding: 0 14px;
      border: 1px solid var(--sl-color-gray-5);
      font-size: var(--sl-text-xs);
      color: var(--sl-color-gray-2);
      background: var(--sl-color-bg);
      width: fit-content;
    }

    .banner-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--sl-color-orange);
      flex-shrink: 0;
      position: relative;
    }

    .banner-dot::before {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--sl-color-orange);
      animation: ping 1.5s ease-out infinite;
    }

    @keyframes ping {
      0% {
        transform: scale(1);
        opacity: 0.8;
      }
      100% {
        transform: scale(2.5);
        opacity: 0;
      }
    }

    .actions {
      gap: 1rem;
      margin: 1.5rem 0 0;
    }
  }

  .actions :global(.sl-link-button) {
    transition:
      background-color 150ms,
      border-color 150ms,
      color 150ms;
  }

  .actions :global(.sl-link-button.primary:hover) {
    background: color-mix(in oklch, var(--sl-color-text-accent) 80%, transparent);
    border-color: transparent;
  }

  .actions :global(.sl-link-button.minimal:hover) {
    color: var(--sl-color-text-accent);
  }
</style>
