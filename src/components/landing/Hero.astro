---
import { LinkButton } from "@astrojs/starlight/components";
import { i18n } from "../i18n/i18n.ts";
import HeroAssistant from "./HeroAssistant.astro";

const { data } = Astro.locals.starlightRoute.entry;
const { tagline, actions = [] } = data.hero || {};
const { hero } = i18n(Astro.locals.starlightRoute.locale);
---

<div class="hero not-content">
  <div class="sl-flex stack">
    <div class="sl-flex top">
      <p class="label">
        <span class="slashes" aria-hidden="true">
          {"//"}
        </span>{" "}
        {hero.label}
      </p>

      <div class="banner">
        <span class="banner-dot"></span>
        <span>{hero.badge}</span>
      </div>
    </div>

    <div class="main">
      <div class="sl-flex stack">
        <h1 data-page-title>
          {hero.title.map((line, i) => (
            <Fragment>
              {i > 0 && <br />}
              {line}
            </Fragment>
          ))}
        </h1>

        {tagline && <p class="tagline" set:html={tagline} />}

        {actions.length > 0 && (
          <div class="sl-flex actions">
            {actions.map(
              ({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
                <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
                  {text}
                  {icon?.html && <Fragment set:html={icon.html} />}
                </LinkButton>
              ),
            )}
          </div>
        )}
      </div>

      <HeroAssistant />
    </div>

    <div class="ledger" aria-hidden="true">
      <p>
        {hero.ledger.debit} <span class="amount">48'210.35</span>
      </p>
      <p>
        {hero.ledger.credit} <span class="amount">48'210.35</span>
      </p>
      <p class="balance">
        {hero.ledger.balance} <span class="amount">0.00</span>
      </p>
    </div>
  </div>
</div>

<style>
  @layer starlight.core {
    .hero {
      padding-block: clamp(1rem, 4vw, 3rem);
    }

    @media (max-width: 49.99rem) {
      .hero {
        padding-block-end: 0;
      }
    }

    .stack {
      flex-direction: column;
      gap: clamp(1.5rem, calc(1.5rem + 1vw), 1.5rem);
    }

    .main {
      display: grid;
      gap: 2.5rem;
    }

    @media (min-width: 50rem) {
      .main {
        grid-template-columns: 1fr minmax(0, 26rem);
        align-items: center;
      }
    }

    .ledger {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      margin-block-start: 2rem;
      padding-block-start: 1rem;
      border-block-start: var(--layout-section-border);
      color: var(--sl-color-gray-3);
      font-size: var(--sl-text-sm);
    }

    .ledger p {
      margin: 0;
    }

    @media (max-width: 49.99rem) {
      .ledger {
        display: none;
      }
    }

    .ledger p:nth-child(2) {
      justify-self: center;
    }

    .ledger .balance {
      justify-self: end;
    }

    .ledger .balance .amount {
      display: inline-block;
      padding-block-end: 0.15rem;
      border-block-end: 3px double var(--sl-color-accent);
    }

    .top {
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }

    .label {
      margin: 0;
      color: var(--sl-color-gray-3);
      font-size: var(--sl-text-sm);
    }

    .slashes {
      color: var(--sl-color-accent);
      font-weight: 700;
    }

    .banner {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      border: 1px solid var(--sl-color-gray-5);
      font-size: var(--sl-text-xs);
      color: var(--sl-color-gray-2);
      background: var(--sl-color-bg);
      width: fit-content;
    }

    .banner-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--sl-color-orange);
      flex-shrink: 0;
      position: relative;
    }

    .banner-dot::before {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--sl-color-orange);
      animation: ping 1.5s ease-out infinite;
    }

    @keyframes ping {
      0% {
        transform: scale(1);
        opacity: 0.8;
      }
      100% {
        transform: scale(2.5);
        opacity: 0;
      }
    }

    h1 {
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
      max-width: 28ch;
      margin: 1rem 0 0;
      letter-spacing: -0.05em;
    }

    .tagline {
      font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
      color: var(--sl-color-gray-2);
      line-height: 1.25;
    }

    .actions {
      gap: 1rem;
      margin: 1.5rem 0 0;
    }
  }

  .actions :global(.sl-link-button) {
    transition:
      background-color 150ms,
      border-color 150ms,
      color 150ms;
  }

  .actions :global(.sl-link-button.primary:hover) {
    background: color-mix(in oklch, var(--sl-color-text-accent) 80%, transparent);
    border-color: transparent;
  }

  .actions :global(.sl-link-button.minimal:hover) {
    color: var(--sl-color-text-accent);
  }

  .hero {
    --hero-grid: color-mix(in oklch, var(--sl-color-hairline-shade) 50%, transparent);
    position: relative;
    isolation: isolate;
  }

  :global(:root[data-theme="light"]) .hero {
    --hero-grid: color-mix(in oklch, var(--sl-color-gray-5) 50%, transparent);
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(to right, var(--hero-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--hero-grid) 1px, transparent 1px);
    background-position: -1px -1px;
    background-size: 56px 56px;
    mask-image:
      radial-gradient(70% 70% at 50% 40%, #000 20%, transparent 100%),
      linear-gradient(to bottom, transparent, #000 15%);
    mask-composite: intersect;
  }
</style>
