---
import { i18n } from "../i18n/i18n.ts";

const {
  hero: { assistant },
} = i18n(Astro.locals.starlightRoute.locale);
---

<nullish-hero-assistant class="assistant">
  <p class="question">
    <span class="prompt" aria-hidden="true">
      {">"}
    </span>{" "}
    <span class="field" aria-hidden="true">
      <span class="ghost">{assistant.question}</span>
      <span class="typed"></span>
    </span>
    <span class="sr-only">{assistant.question}</span>
  </p>
  <p class="thought">
    <span class="thinking" aria-hidden="true">
      {assistant.thinking}
    </span>
    <span class="done">{assistant.thought}</span>
  </p>
  <div class="reveal">
    <p class="answer">{assistant.answer}</p>
    <p class="detail">{assistant.detail}</p>
  </div>
</nullish-hero-assistant>

<script is:inline>
  if (!customElements.get("nullish-hero-assistant")) {
    customElements.define(
      "nullish-hero-assistant",
      class extends HTMLElement {
        #timer = undefined;

        connectedCallback() {
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            return;
          }

          const ghost = this.querySelector(".ghost");
          const typed = this.querySelector(".typed");
          const text = ghost?.textContent?.trim() ?? "";

          if (typed === null || text === "") {
            return;
          }

          this.classList.add("typing");

          let index = 0;

          const type = () => {
            index++;
            typed.textContent = text.slice(0, index);

            if (index < text.length) {
              this.#timer = setTimeout(type, 45);
              return;
            }

            this.classList.replace("typing", "typed");
          };

          this.#timer = setTimeout(type, 400);
        }

        disconnectedCallback() {
          clearTimeout(this.#timer);
        }
      },
    );
  }
</script>

<style>
  .assistant {
    display: grid;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--sl-color-gray-6);
    border: var(--layout-section-border);
  }

  .assistant p {
    margin: 0;
  }

  .question {
    color: var(--sl-color-white);
  }

  .prompt {
    color: var(--sl-color-accent);
    font-weight: 700;
  }

  .field {
    display: inline-grid;
  }

  .field > span {
    grid-area: 1 / 1;
  }

  .typing .ghost {
    visibility: hidden;
  }

  .typing .typed::after {
    content: "▍";
    color: var(--sl-color-accent);
    animation: blink 1s steps(1) infinite;
  }

  .thought {
    display: grid;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .thought > span {
    grid-area: 1 / 1;
  }

  .thinking {
    opacity: 0;
  }

  .typing .thought,
  .typing .reveal {
    visibility: hidden;
  }

  .typed .thinking {
    opacity: 1;
    animation:
      pulse 0.8s ease-in-out 2 alternate,
      fade-out 0.2s 1.6s forwards;
  }

  .typed .done {
    opacity: 0;
    animation: fade-in 0.3s 1.6s forwards;
  }

  .typed .reveal {
    opacity: 0;
    translate: 0 0.25rem;
    animation: fade-in 0.4s 1.8s forwards;
  }

  .answer {
    color: var(--sl-color-white);
    font-size: var(--sl-text-3xl);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .assistant .detail {
    margin-block-start: 0.25rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @keyframes pulse {
    to {
      opacity: 0.4;
    }
  }

  @keyframes fade-out {
    to {
      opacity: 0;
    }
  }

  @keyframes fade-in {
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>
