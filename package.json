{
  "name": "@usenullish/site",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --recursive --parallel run dev",
    "env:dev": "./env.run.sh dev",
    "build": "pnpm --recursive run build",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "e2e": "NODE_ENV=development playwright test",
    "e2e:ci": "playwright test --reporter=html",
    "e2e:report": "playwright show-report",
    "e2e:playwright:install": "playwright install chromium --with-deps"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.5.1"
}
