{
  "name": "@usenullish/site",
  "version": "0.0.3",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pnpm build:md && pnpm build:precompress",
    "build:md": "node scripts/generate-md.ts",
    "build:precompress": "node scripts/precompress.ts",
    "preview": "astro preview",
    "astro": "astro",
    "sync-docs": "node scripts/sync-docs.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "i18n": "node ./scripts/i18n.ts && oxfmt src/components/i18n/i18n.types.ts",
    "env:dev": "./env.run.sh dev"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.14",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "nodemailer": "^10.6.1"
  },
  "devDependencies": {
    "@astrojs/markdoc": "^2.1.3",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.10",
    "@astrojs/starlight-markdoc": "^0.7.0",
    "@types/nodemailer": "^8.0.2",
    "@types/turndown": "^5.0.6",
    "astro": "^7.4.7",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "sharp": "^0.35.5",
    "starlight-llms-txt": "^0.12.0",
    "turndown": "^7.2.5"
  },
  "packageManager": "pnpm@12.5.1"
}
