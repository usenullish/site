{
  "name": "@usenullish/site",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --recursive --parallel run dev",
    "build": "pnpm --recursive run build",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.5.1"
}
